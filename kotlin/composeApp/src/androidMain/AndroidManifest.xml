<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reklam kimliği izni AdMob için gerekli (istatistik tarafında yine KULLANILMAZ: aşağıdaki Firebase ayarları kapalı) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Android 13+: bildirim göstermek için kullanıcıdan izin istenir (ilk kayıtta bir kez, sonra Profil'den aç/kapat) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:label="${uygAd}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Firebase Analytics: izin verilene kadar KAPALI; reklam kimliği ve kişiselleştirilmiş reklam sinyalleri HİÇ toplanmaz -->
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />
        <!-- Firebase ile AdMob aynı ayarı tanımlıyor: AdMob'unki geçerli -->
        <property android:name="android.adservices.AD_SERVICES_CONFIG" android:resource="@xml/gma_ad_services_config" tools:replace="android:resource" />
        <!-- AdMob uygulama kimliği (build.gradle.kts: test / gerçek) -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${admobUygulama}" />
        <!-- Ana ekran parçacığı -->
        <receiver android:name=".Pencere" android:exported="false" android:label="Memur Ol">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/pencere_bilgi" />
        </receiver>
    </application>
</manifest>
